        <dia:composite type="text">
          <dia:attribute name="string">
            <dia:string>##ALGORITMO VERIFICAR PAR OU ÍMPAR
#VAR N INTEIRO
N = int(input("Entre com um número inteiro:\n"))
if(N % 2 == 0):
    print("O número"  + N + "é par"
else:
    print("O núemro" + N + "é ímpar"
#</dia:string>
          </dia:attribute>
          <dia:attribute name="font">
