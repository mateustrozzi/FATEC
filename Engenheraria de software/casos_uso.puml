@startuml
left to right direction

actor "Leiloeiro" as Leiloeiro
actor "Participante" as Participante

rectangle "Sistema de Leilão via Internet" {

  usecase "Realizar Login" as UC1

  usecase "Cadastrar Leilão" as UC2
  usecase "Cadastrar Itens" as UC3
  usecase "Definir Datas e Horários" as UC4

  usecase "Registrar Participante" as UC5
  usecase "Consultar Itens" as UC6
  usecase "Realizar Lance" as UC7
  usecase "Consultar Resultado" as UC8

  usecase "Validar Lance Mínimo" as UC9
}

Leiloeiro --> UC1
Leiloeiro --> UC2
Leiloeiro --> UC3
Leiloeiro --> UC4

Participante --> UC5
Participante --> UC6
Participante --> UC7
Participante --> UC8

UC2 .> UC1 : <<include>>
UC3 .> UC1 : <<include>>
UC4 .> UC1 : <<include>>

UC2 .> UC3 : <<include>>
UC2 .> UC4 : <<include>>

UC7 .> UC9 : <<include>>

@enduml